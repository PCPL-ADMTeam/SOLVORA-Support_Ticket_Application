# Copy this file to .env and fill in real values before running the server.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Postgres connection string used by Prisma.
# Local (non-docker) dev: postgresql://helpdesk:helpdesk_dev_password@localhost:5432/helpdesk
DATABASE_URL="postgresql://helpdesk:helpdesk_dev_password@127.0.0.1:5433/helpdesk"


# JWT secrets — generate strong random values, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Default admin account created by prisma/seed.js
SEED_ADMIN_EMAIL=admin@helpdesk.local
SEED_ADMIN_PASSWORD=Admin@12345

# SMTP / email notifications (Nodemailer). For local dev, point this at
# Mailtrap, Ethereal, or leave blank — emails are logged to the console
# instead of sent when SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Helpdesk <no-reply@helpdesk.local>"

# CloudReady Microsoft Entra ID (Microsoft Graph) — used for the corporate
# directory lookup (GET /users/entra-directory) and for sending ticket
# emails via Graph instead of SMTP. Create an app registration in Entra
# with a client-credentials secret and Application permission User.Read.All
# (directory lookup) and Mail.Send (sending as CLOUDREADY_MAILBOX). Leave
# all four blank to run without CloudReady — email then falls back to the
# Helpdesk user's own `email` field and is logged via the console mailer.
# NEVER commit real values here or in .env — rotate immediately if one leaks.
CLOUDREADY_TENANT_ID=
CLOUDREADY_CLIENT_ID=
CLOUDREADY_CLIENT_SECRET=
# The one shared mailbox Graph sends ticket emails "from" — never a
# per-request/client-supplied address.
CLOUDREADY_MAILBOX=

# File uploads — legacy local disk fallback (still used to serve
# attachments uploaded before the Azure Blob Storage migration; new
# uploads go to Azure instead, see AZURE_STORAGE_* below).
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Azure Blob Storage — where new ticket attachments are stored. The
# container is created automatically (private, no public access) on first
# use if it doesn't already exist. Leave all three blank to run without
# Azure configured; attachment uploads will then fail with a clear error
# rather than silently falling back anywhere.
# NEVER commit real values here or in .env — rotate immediately if one leaks.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=attachments

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Chatbot (see docs/chatbot-deployment.md).
# CHATBOT_PROVIDER: "mock" (default; deterministic, no network — local dev and
# tests) or "anthropic" (Anthropic Messages API). With "anthropic",
# CHATBOT_API_KEY and CHATBOT_MODEL are required or the server logs a config
# error at first chat request and the chatbot answers from templates only.
# NEVER commit a real key here or in .env.
CHATBOT_PROVIDER=mock
CHATBOT_MODEL=
# Optional override; defaults to https://api.anthropic.com/v1/messages
CHATBOT_ENDPOINT=
CHATBOT_API_KEY=
CHATBOT_TIMEOUT_MS=15000
CHATBOT_MAX_RETRIES=1
# Per authenticated user, per window.
CHATBOT_RATE_LIMIT_WINDOW_MS=60000
CHATBOT_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# AI interpretation (OpenRouter). The rule engine always runs first; the model
# is only asked when no reliable rule matches. The model only INTERPRETS (picks
# one registered intent + parameters); it never reads the database, executes
# tools, or confirms changes. See docs/chatbot-ai-interpretation.md.
# NEVER commit a real key. Keep it blank here and set it in your private .env.
# ---------------------------------------------------------------------------
AI_INTERPRETATION_ENABLED=true
AI_PROVIDER=openrouter

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_server_side_key

# Populate after checking OpenRouter's current model catalog: run
#   cd server && npm run ai:check
# Model ids are never hard-coded; an unverified/expired id disables AI
# interpretation (rules keep working) instead of silently switching models.
OPENROUTER_INTENT_MODEL=
OPENROUTER_INTENT_FALLBACK_MODELS=

OPENROUTER_SUMMARY_MODEL=
OPENROUTER_SUMMARY_FALLBACK_MODELS=

OPENROUTER_TIMEOUT_MS=10000
OPENROUTER_MAX_RETRIES=1
OPENROUTER_MIN_CONFIDENCE=0.80
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_OUTPUT_TOKENS=500
# Reasoning models can use the whole output budget thinking. Empty = model default;
# off | low | medium | high. For intent classification use "off" or "low", and raise
# OPENROUTER_MAX_OUTPUT_TOKENS (e.g. 1500) if a model has mandatory reasoning.
OPENROUTER_REASONING_EFFORT=

OPENROUTER_REQUIRE_STRUCTURED_OUTPUT=true
OPENROUTER_REQUIRE_SUPPORTED_PARAMETERS=true

OPENROUTER_APP_NAME=Solvora Support Assistant
OPENROUTER_APP_URL=

AI_LOG_PROMPTS=false
AI_LOG_RESPONSES=false
AI_REDACT_SENSITIVE_DATA=true

# Additional controls (optional)
# Comma-separated upstream providers you have approved for your data; empty = OpenRouter decides.
OPENROUTER_ALLOWED_PROVIDERS=
# deny = route only to providers that do not retain/train on prompts.
OPENROUTER_DATA_COLLECTION=deny
AI_MAX_INPUT_CHARS=1000
AI_MAX_CALLS_PER_USER_PER_DAY=200
AI_CIRCUIT_BREAKER_FAILURES=3
AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000
AI_CAPABILITY_CACHE_MS=3600000
# Include the model id in chat responses (default: true outside production).
AI_EXPOSE_MODEL_METADATA=
