// Prisma schema for the IT Helpdesk / Ticketing system.
// Run `npx prisma migrate dev --name init` inside /server to create the DB and apply this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

// Kept as a table (rather than a hardcoded enum) so an Admin could in principle
// manage roles later; seed.js guarantees ADMIN / MANAGER / TEAMLEAD / EMPLOYEE
// always exist. Historical note: this used to be ADMIN / AGENT / USER — AGENT
// was renamed to TEAMLEAD and USER to EMPLOYEE, and MANAGER was added, via a
// data-only migration (see the migration that renames these role rows) that
// never touched any user's roleId — only the Role row's own name/label.
model Role {
  id        String   @id @default(cuid())
  name      String   @unique // ADMIN | MANAGER | TEAMLEAD | EMPLOYEE
  label     String
  createdAt DateTime @default(now())

  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  roleId       String
  isActive     Boolean   @default(true)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  departmentId String?
  isManager    Boolean   @default(false)

  // Stable link to this user's CloudReady Microsoft Entra ID account (the
  // Entra object id, a GUID) — set by an Admin via the entra-directory
  // mapping flow. Preferred over email for identity because email can
  // change; `email` itself remains the Helpdesk login identity and is
  // unaffected. Nullable since most users won't be mapped until an Admin
  // links them.
  entraObjectId String? @unique

  role       Role        @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  teamMemberships   TeamMember[]
  requestedTickets  Ticket[]          @relation("TicketRequester")
  assignedTickets   Ticket[]          @relation("TicketAssignee")
  // Kept for backward compatibility/history only — Ticket.managerId is no
  // longer the source of truth for department-management authorization (see
  // UserDepartmentAccess below); it still records which TEAMLEAD/MANAGER a
  // ticket was originally routed under at creation/transfer time.
  managedTickets    Ticket[]          @relation("TicketManager")
  comments          TicketComment[]
  attachmentsUploaded TicketAttachment[]
  historyEntries    TicketHistory[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  // Department-management access — the source of truth for "which
  // departments can this MANAGER/TEAMLEAD manage." A MANAGER may hold
  // several of these rows (multi-department); a TEAMLEAD holds exactly one
  // (enforced in userDepartmentAccess.service.js, not at the DB level, same
  // as the MAX_TEAMLEADS_PER_DEPARTMENT limit). Replaces the old single
  // isManager+departmentId model for authorization purposes; isManager and
  // departmentId remain on this model unchanged for backward compatibility.
  departmentAccess        UserDepartmentAccess[] @relation("UserDepartmentAccessUser")
  grantedDepartmentAccess UserDepartmentAccess[] @relation("UserDepartmentAccessGrantedBy")
  ticketCCs               TicketCC[]              @relation("TicketCCUser")
  addedTicketCCs          TicketCC[]              @relation("TicketCCAddedBy")

  @@index([roleId])
  @@index([departmentId])
  @@map("users")
}

// The role-neutral source of truth for MANAGER/TEAMLEAD <-> Department
// authorization (see ticket.service.js's scope/authorization functions).
// Originally modeled as AgentDepartmentAccess (single AGENT role); renamed
// and generalized to cover both management roles once MANAGER was added
// alongside the AGENT->TEAMLEAD rename (see the migration that renames this
// table/column — existing rows and their data are preserved unchanged, only
// renamed). A MANAGER may have access to several departments; a TEAMLEAD
// holds exactly one row (app-enforced, see userDepartmentAccess.service.js).
// One department may have multiple MANAGERs (no cap) and up to
// MAX_TEAMLEADS_PER_DEPARTMENT TEAMLEADs (see server/src/config/constants.js).
// Deliberately NOT modeled as a single managerId field — that was the old,
// replaced model. User.departmentId and User.isManager are left untouched
// elsewhere in this schema and are no longer read for department-management
// authorization decisions.
model UserDepartmentAccess {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  createdAt    DateTime @default(now())
  createdBy    String?

  user       User       @relation("UserDepartmentAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("UserDepartmentAccessGrantedBy", fields: [createdBy], references: [id])

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_department_access")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// "Forgot Password" flow. Mirrors RefreshToken's own storage convention
// exactly: only a SHA-256 hash of the raw token is ever persisted (see
// utils/jwt.js#hashToken, reused as-is) — the raw, cryptographically
// random token itself is emailed to the user once and never stored
// anywhere. usedAt (nullable) makes a token single-use: set the moment a
// reset succeeds, and checked alongside expiresAt before honoring any
// token (see auth.service.js#resetPassword).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Teams
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
  tickets Ticket[]

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// Organizational departments (ticket routing target on the raise-a-ticket
// form — distinct from Team, which groups agents for ticket ownership/RBAC).
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Department identity fields only — NOT used to generate Ticket.ticketNumber
  // (that's now a global numeric sequence derived from Ticket.seq; see
  // ticket.service.js#buildTicketNumber). Kept for department-identity
  // display (e.g. DepartmentDetailsPage's "Prefix" chip) and left untouched
  // by ticket creation. Not exposed as directly editable in the Admin UI.
  ticketPrefix   String @unique
  ticketSequence Int    @default(0)

  users   User[]
  issues  Issue[]

  ticketsFrom Ticket[] @relation("TicketFromDepartment")
  ticketsTo   Ticket[] @relation("TicketToDepartment")
  userAccess  UserDepartmentAccess[]

  @@map("departments")
}

// Legacy per-department issue list — no longer used by ticket creation
// (replaced by the free-text Problem Summary field; see
// ticket.service.js#createTicket and Ticket.problemSummary below). Left in
// place, dormant, purely for historical/backward-compatibility reasons
// (mirrors how Team/TeamMember were kept after the four-role migration) —
// never read or written by any current ticket flow.
model Issue {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  isOther      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([name, departmentId])
  @@index([departmentId])
  @@map("issues")
}

// ---------------------------------------------------------------------------
// Ticket taxonomy
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")
  tickets  Ticket[]

  @@unique([name, parentId])
  @@map("categories")
}

// Low / Medium / High / Critical — ordered by `level` (1 = lowest). SLA
// functionality (response/resolution time targets) has been removed from
// the system entirely — Priority itself remains exactly as before, used
// for ticket selection/filtering/display and the dashboard's Priority
// breakdown chart.
model Priority {
  id        String   @id @default(cuid())
  name      String   @unique
  level     Int      @unique
  color     String   @default("#757575")
  createdAt DateTime @default(now())

  tickets    Ticket[]

  @@map("priorities")
}

// ---------------------------------------------------------------------------
// Tickets
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  REOPENED
}

model Ticket {
  id           String       @id @default(cuid())
  // Human-facing, globally unique, purely numeric sequence powering
  // ticketNumber, e.g. seq=27001 -> ticketNumber "2627001" (see
  // ticket.service.js#buildTicketNumber). Postgres-native autoincrement —
  // inherently collision-safe, no manual locking/increment needed.
  seq          Int          @default(autoincrement())
  ticketNumber String       @unique
  title        String
  // Free-text "Problem Summary" (<=50 words, enforced in
  // ticket.validator.js / ticket.service.js) — replaces the old predefined
  // Issue dropdown + rich-text Description. Column kept (renamed from the
  // former `description`) so existing tickets' content is preserved rather
  // than dropped.
  problemSummary String     @db.Text
  status       TicketStatus @default(OPEN)

  categoryId String?
  priorityId String
  requesterId String
  assigneeId  String?
  teamId      String?

  fromDepartmentId String?
  toDepartmentId   String?
  managerId        String?

  resolvedAt     DateTime?
  closedAt       DateTime?

  // Required, persisted reason text for the three status transitions that
  // need an explanation (see ticket.service.js#updateTicket). Nullable
  // because a ticket only ever has these once it's actually passed through
  // that status — and only the LATEST occurrence is kept here (a ticket
  // resolved twice keeps only the second note); the full history of every
  // occurrence lives in TicketHistory instead (RESOLUTION_NOTES/
  // ON_HOLD_REASON/CLOSED_REASON entries), which is never overwritten.
  resolutionNotes String? @db.Text
  onHoldReason    String? @db.Text
  closedReason    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  Category? @relation(fields: [categoryId], references: [id])
  priority  Priority @relation(fields: [priorityId], references: [id])
  requester User     @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User?    @relation("TicketAssignee", fields: [assigneeId], references: [id])
  team      Team?    @relation(fields: [teamId], references: [id])

  fromDepartment Department? @relation("TicketFromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartment   Department? @relation("TicketToDepartment", fields: [toDepartmentId], references: [id])
  manager        User?       @relation("TicketManager", fields: [managerId], references: [id])

  comments    TicketComment[]
  attachments TicketAttachment[]
  history     TicketHistory[]
  notifications Notification[]
  // Custom CC users selected by the requester at ticket-creation time.
  // Fixed for the life of the ticket — a later department transfer does NOT
  // change this list (see ticket.service.js#transferDepartment).
  ccUsers     TicketCC[]

  @@index([status])
  @@index([priorityId])
  @@index([assigneeId])
  @@index([requesterId])
  @@index([categoryId])
  @@index([teamId])
  @@index([createdAt])
  @@index([toDepartmentId])
  @@index([managerId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String   @db.Text
  isInternal Boolean  @default(false) // internal notes hidden from end users
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  commentId    String?
  uploadedById String
  fileName     String
  // "local" (legacy, pre-Azure-migration): filePath is the random filename
  // multer wrote under server/uploads/. "azure" (current): filePath is the
  // full blob name (attachments/<ticketId>/<unique-id>-<name>) inside the
  // AZURE_STORAGE_CONTAINER_NAME container — never a full URL, and never
  // the storage connection string/key. See blobStorage.service.js and
  // ticket.service.js#streamAttachment, which branch on this field to know
  // where to actually read the bytes from.
  filePath        String
  storageProvider String @default("local")
  fileSize        Int
  mimeType        String
  createdAt       DateTime @default(now())

  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment    TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@map("ticket_attachments")
}

// Custom CC recipients the requester chose while raising the ticket (see
// TicketForm.jsx's Custom CC search/chip UI). CC'd on every subsequent
// email event for this ticket (see the central recipient builder,
// utils/recipientBuilder.js) — never changes on department transfer.
model TicketCC {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  addedBy   String?
  createdAt DateTime @default(now())

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User   @relation("TicketCCUser", fields: [userId], references: [id])
  addedByUser User?  @relation("TicketCCAddedBy", fields: [addedBy], references: [id])

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
  @@map("ticket_cc")
}

// Full activity/audit trail scoped to a single ticket (status changes,
// reassignment, priority changes, etc.) shown on the ticket detail timeline.
model TicketHistory {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  action    String // e.g. STATUS_CHANGE, ASSIGNED, PRIORITY_CHANGE, COMMENTED, REOPENED
  fieldName String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@map("ticket_history")
}

// ---------------------------------------------------------------------------
// Notifications & system-wide audit log
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  ticketId  String?
  type      String // TICKET_CREATED | TICKET_ASSIGNED | STATUS_CHANGED | NEW_COMMENT
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// Database-driven content for ticket-lifecycle emails/notifications —
// PostgreSQL decides WHAT an event's email says; ticket.service.js only
// decides WHEN it fires and WHO receives it (see emailTemplate.service.js
// for rendering and notification.service.js for the send path). eventKey
// is one of the fixed TICKET_* constants ticket.service.js emits — never
// client-supplied or dynamically generated.
model EmailTemplate {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  name      String
  subject   String
  body      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

// System-wide log of sensitive/administrative actions (distinct from
// TicketHistory, which is ticket-scoped only).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // e.g. USER_CREATED, USER_DEACTIVATED, PRIORITY_UPDATED, TICKET_BULK_ASSIGN
  entityType String // e.g. User, Ticket, Category, Priority
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
